# Base de datos (se genera localmente, no se sube)
*.db

# Exportaciones (PDF generados, no se suben)
exportado/

# Artefactos de PyInstaller (el .exe se genera localmente, no se sube)
build/
dist/
*.spec

# Artefactos de Nuitka (compilacion a .exe)
*.build/
*.dist/
*.onefile-build/

# Archivos de Python
__pycache__/
*.pyc

# Entornos virtuales
venv/
env/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Configuración de editores
.vscode/
.idea/

# Reporte intermedio de coverage.py (se regenera en cada corrida de CI,
# no hace falta versionarlo; coverage.svg si se versiona)
.coverage
coverage.json
